import { TextEdit } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, DialogRow, DialogSection, Modal, Progress } from "../primitives/modal.slint";
import { NumberField } from "../primitives/number-field.slint";
import { Check } from "../inspector/controls.slint";

// Smart cut (智能剪口播): what a clip's menu opens.
//
// The clip's speech is transcribed as soon as the sheet opens, with the
// transcriber the captions sheet uses. Then two ways to cut: the
// transcript as editable text - delete words and apply, and the stretches
// they were said in leave the timeline - and a list of suggested cuts,
// filler words, repeats and long pauses, each with a check box, deleted
// together. Every cut is one undo step. On a desk it is a card floating
// over the editor; on a phone, a sheet.

export struct SmartCutRowData {
    /// The kind, in words: filler, repeat, pause.
    kind: string,
    /// Where it is in the clip, "0:01.20 - 0:01.80".
    time: string,
    /// The words it takes out; empty for a pause.
    words: string,
    checked: bool,
}

export struct SmartCutSheetData {
    open: bool,
    running: bool,
    /// The clip's name.
    clip: string,
    has-transcript: bool,
    /// The transcript, as edited.
    text: string,
    /// Bumped when `text` is replaced from outside the box.
    revision: int,
    cuts: [SmartCutRowData],
    /// How many cuts are checked.
    selected: int,
    pause-min: float,
    pause-keep: float,
    progress: float,
    ceiling: float,
    step: float,
    stage: string,
    message: string,
}

export component SmartCutDialog inherits Modal {
    in property <SmartCutSheetData> data;

    callback text-edited(text: string);
    callback apply-text();
    callback cut-toggled(row: int, on: bool);
    callback select-all();
    callback select-none();
    callback pause-min-changed(seconds: float);
    callback pause-keep-changed(seconds: float);
    callback delete-selected();
    callback retry();
    callback cancel();

    open: root.data.open;
    title: I18n.t("smartCut.smartCut");
    glyph: Glyph.text-mark;
    surface-width: 520px;
    dismissable: true;

    // The transcript being edited, held apart from `data.text` and
    // re-seeded only when the pane replaces it (a new transcription, or
    // after a cut), never while it is being typed into.
    property <string> draft;
    property <int> seeded: -1;
    changed data => {
        if (root.data.revision != root.seeded) {
            root.seeded = root.data.revision;
            root.draft = root.data.text;
        }
    }
    init => {
        root.seeded = root.data.revision;
        root.draft = root.data.text;
    }
    property <float> pause-min: root.data.pause-min;
    property <float> pause-keep: root.data.pause-keep;

    VerticalLayout {
        if root.data.running: VerticalLayout {
            padding: 14px;
            spacing: 8px;

            Text {
                text: root.data.stage;
                color: Theme.fg;
                font-size: Theme.fs;
            }

            Progress {
                value: root.data.progress;
                ceiling: root.data.ceiling;
                step: root.data.step * 1s;
                live: true;
            }

            HorizontalLayout {
                alignment: start;
                Button {
                    label: I18n.t("common.cancel");
                    glyph: Glyph.close;
                    ghost: true;
                    clicked => { root.cancel(); }
                }
            }
        }

        if !root.data.running && root.data.has-transcript: DialogSection {
            first: true;
            title: I18n.t("smartCut.transcript");
            hint: I18n.t("smartCut.transcriptHint");

            TextEdit {
                height: 150px;
                text <=> root.draft;
                wrap: word-wrap;
                font-size: Theme.fs-lg;
                edited(text) => { root.text-edited(text); }
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    label: I18n.t("smartCut.applyTextEdit");
                    glyph: Glyph.check;
                    primary: true;
                    clicked => { root.apply-text(); }
                }
            }
        }

        if !root.data.running && root.data.has-transcript: DialogSection {
            title: I18n.t("smartCut.suggestedCuts");

            DialogRow {
                label: I18n.t("smartCut.pauseAtLeast");
                NumberField {
                    value <=> root.pause-min;
                    minimum: 0.1;
                    maximum: 10;
                    step: 0.05;
                    precision: 2;
                    unit: "s";
                    changed(v) => { root.pause-min-changed(v); }
                }
            }

            DialogRow {
                label: I18n.t("smartCut.pauseKeep");
                NumberField {
                    value <=> root.pause-keep;
                    minimum: 0;
                    maximum: 10;
                    step: 0.05;
                    precision: 2;
                    unit: "s";
                    changed(v) => { root.pause-keep-changed(v); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: I18n.t1("smartCut.selectedCount", "\{root.data.selected}/\{root.data.cuts.length}");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }
                Button {
                    label: I18n.t("smartCut.selectAll");
                    ghost: true;
                    clicked => { root.select-all(); }
                }
                Button {
                    label: I18n.t("smartCut.selectNone");
                    ghost: true;
                    clicked => { root.select-none(); }
                }
            }

            if root.data.cuts.length == 0: Text {
                text: I18n.t("smartCut.noSuggestions");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            if root.data.cuts.length > 0: Rectangle {
                height: Math.min(200px, root.data.cuts.length * 28px + 8px);
                border-radius: Theme.r;
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.line;
                clip: true;

                Flickable {
                    content-height: root.data.cuts.length * 28px + 8px;

                    VerticalLayout {
                        padding: 4px;
                        alignment: start;

                        for row[index] in root.data.cuts: HorizontalLayout {
                            height: 28px;
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                Check {
                                    checked: row.checked;
                                    toggled(on) => { root.cut-toggled(index, on); }
                                }
                            }

                            Text {
                                width: 64px;
                                text: row.kind;
                                color: Theme.fg;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 128px;
                                text: row.time;
                                color: Theme.fg-muted;
                                font-family: Theme.font-technical;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: row.words;
                                color: Theme.fg-dim;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    label: I18n.t("smartCut.deleteSelected");
                    glyph: Glyph.trash;
                    danger: true;
                    enabled: root.data.selected > 0;
                    clicked => { root.delete-selected(); }
                }
            }
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            if root.data.message != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.danger-soft;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.message;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        alignment: start;
                        CopyChip { text: root.data.message; }
                    }
                }
            }

            if !root.data.running && !root.data.has-transcript: Button {
                block: true;
                ghost: true;
                glyph: Glyph.text-mark;
                label: I18n.t("smartCut.transcribeAgain");
                clicked => { root.retry(); }
            }
        }
    }
}
